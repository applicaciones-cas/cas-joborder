<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="180" prefWidth="300.0" styleClass="dialog-root" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <!-- Prompt Label -->
        <Label layoutX="20" layoutY="20" styleClass="dialog-label" text="Select Pit " />

        <!-- ComboBox with 4 Static Choices -->
        <ComboBox fx:id="cbPitSelection" layoutX="20" layoutY="55" prefWidth="310.0" styleClass="dialog-combobox" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="01" />
                    <String fx:value="02" />
                    <String fx:value="03" />
                    <String fx:value="04" />
                </FXCollections>
            </items>
        </ComboBox>

        <!-- OK and Cancel Buttons -->
        <Button fx:id="okButton" layoutX="70" layoutY="115" onAction="#onOkClicked" prefWidth="90" styleClass="dialog-button" text="OK" AnchorPane.rightAnchor="100.0" />

        <Button fx:id="cancelButton" layoutX="190" layoutY="115" onAction="#onCancelClicked" prefWidth="90" styleClass="dialog-button" text="Cancel" AnchorPane.rightAnchor="0.0" />
    </children>
   <stylesheets>
      <URL value="@../css/contestchoice.css" />
      <URL value="@../css/pitSelection.css" />
   </stylesheets>
</AnchorPane>
